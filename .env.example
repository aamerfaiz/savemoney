# Finance OS — environment variables.
# Copy to `.env.local` (git-ignored) and fill in the values.
# Without these, the app runs in demo mode on mock data.
#
# Supabase project: FinanceOS (ref: ucgholzcnqqwwentdaqt)
# Dashboard → Project Settings → API for the URL + keys.

# Public — safe to expose in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://ucgholzcnqqwwentdaqt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — Drizzle connection (postgres-js).
# Dashboard → Connect → use the pooled connection string and paste the
# project's database password. Port 6543 = transaction pooler (serverless).
DATABASE_URL=postgresql://postgres.ucgholzcnqqwwentdaqt:[YOUR-DB-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
