# Supabase — Auth + Postgres (PostgREST). Without these the app runs in
# demo mode on mock data (see AGENTS.md "Auth").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct Postgres connection (Supabase "Transaction" pooler, port 6543).
# Used by drizzle-kit migrations and by src/db/index.ts for the handful of
# server-only reads/writes that can't go through PostgREST — currently just
# the private.ai_provider_keys table (see AGENTS.md "AI providers & user
# API keys").
DATABASE_URL=

# Phase 3 BYOK — server-only AES-256-GCM key for encrypting each user's AI
# provider API key at rest. Must decode (base64) to exactly 32 bytes, e.g.:
#   openssl rand -base64 32
AI_KEYS_ENCRYPTION_KEY=
