# Supabase — Auth + Postgres (PostgREST). Without these the app runs in
# demo mode on mock data (see AGENTS.md "Auth").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Direct Postgres connection (Supabase "Transaction" pooler, port 6543).
# Used by drizzle-kit migrations and by src/db/index.ts for server-only
# reads/writes that can't go through PostgREST — the private.ai_provider_keys/
# vault_keys/mcp_agent_tokens tables (see AGENTS.md "AI providers & user API
# keys" and docs/e2ee-path-b-plan.md), plus bulk cross-table reads/writes for
# vault rotation and backfill.
DATABASE_URL=
