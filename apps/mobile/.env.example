# Supabase — Auth (Postgres/PostgREST access goes through
# apps/web's /api/v1/* Route Handlers, not directly from the mobile app).
# EXPO_PUBLIC_ prefix is required for Expo to inline these into the app
# bundle — see https://docs.expo.dev/guides/environment-variables/.
# Same values as apps/web/.env.example's NEXT_PUBLIC_SUPABASE_* pair —
# one Supabase project, two client configs.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the apps/web deployment this app calls through
# @savemoney/api-client for bearer-token REST access (vault setup/unlock,
# and whatever /api/v1/* routes land alongside each Phase 5.5 screen).
EXPO_PUBLIC_API_BASE_URL=
