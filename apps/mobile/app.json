{
  "expo": {
    "name": "Finance OS",
    "slug": "finance-os",
    "owner": "aamers-apps",
    "version": "1.0.0",
    "scheme": "savemoney",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.savemoney.financeos"
    },
    "android": {
      "package": "com.savemoney.financeos",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
